# CitizenAssist AI Environment Configuration
# Copy this file to .env and fill in the values

# === Gemini AI (optional - app works without it in retrieval-only mode) ===
# Get a free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# === Security (generated automatically by setup script) ===
SECRET_KEY=change-me-to-a-random-string

# === Database ===
DATABASE_URL=sqlite:///./data/citizenassist.db

# === Admin Account (generated automatically by setup script) ===
ADMIN_EMAIL=admin@citizenassist.local

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=false

# === Optional: Local sentence-transformers (off by default) ===
USE_LOCAL_EMBEDDINGS=false
